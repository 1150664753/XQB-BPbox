/XQB-BPbox/assets/audios/
/XQB-BPbox/assets/backgrounds/
/XQB-BPbox/assets/characters/
/XQB-BPbox/assets/effects/
/XQB-BPbox/assets/hire/
/XQB-BPbox/assets/lightcones/
/XQB-BPbox/assets/videos/

# Local configuration and generated results
/XQB-BPbox/config/
/XQB-BPbox/results/

# Environment files, credentials, and signing keys
.env
.env.*
!.env.example
!.env.example.*
*.pem
*.key
*.pfx
*.p12
*.keystore

# Logs, caches, and temporary files
/XQB-BPbox/.eslintcache
/XQB-BPbox/.cache/
/XQB-BPbox/.tmp/
/XQB-BPbox/tmp/
/XQB-BPbox/temp/
/XQB-BPbox/**/*.tmp
/XQB-BPbox/**/*.temp
/XQB-BPbox/**/*.log*

# Operating-system metadata
.DS_Store
Thumbs.db

# Local archives and large source videos
/XQB-BPbox/**/*.zip
/XQB-BPbox/**/*.7z
/XQB-BPbox/**/*.rar
/XQB-BPbox/**/*.mov
