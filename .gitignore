# Node / npm dependencies
/XQB-BPbox/node_modules/

# Electron / Vite build and packaging output
/XQB-BPbox/dist/
/XQB-BPbox/out/
/XQB-BPbox/release/
/XQB-BPbox/**/*.exe
/XQB-BPbox/**/*.msi
/XQB-BPbox/**/*.msix
/XQB-BPbox/**/*.appx
/XQB-BPbox/**/*.blockmap
/XQB-BPbox/**/latest*.yml

# Local runtime assets
